# ---- HR CRM docker-compose environment ----
# Copy this file to .env in the SAME directory as docker-compose.yml
# and change the values below before running `docker compose up -d`.

# -------------------------------
# Dockploy / Traefik Domain
# -------------------------------
# Public domain used for Traefik routing + Let's Encrypt certificate.
# DOCKPLOY_USERS: Dockploy auto-injects labels; you can leave this commented out
# and set the hostnames directly inside the compose labels.
# PUBLIC_DOMAIN=hrcrm.devhasib.lol

# -------------------------------
# Frontend / Nginx
# -------------------------------
# Public port for the web UI. Open http://<your-ip>:8080 in the browser.
# DOCKPLOY_USERS: Ignore this on Dockploy — Traefik routes on port 443 via the labels.
WEB_PORT=8080

# -------------------------------
# Backend / FastAPI
# -------------------------------
# Port the API listens on (localhost only — nginx/Traefik proxies /api to this).
# Only expose this directly if you need to access /docs outside docker.
API_PORT=8000

# Strong, random secret for JWT signing.
# Generate via: python -c "import secrets; print(secrets.token_urlsafe(64))"
API_SECRET_KEY=replace-me-with-a-64-char-random-string-from-the-command-above

# JWT token lifetime in minutes. 43200 = 30 days.
TOKEN_EXPIRE_MINUTES=43200

# -------------------------------
# Database (PostgreSQL — recommended for production / Dockploy)
# -------------------------------
# Username / password / DB name for the built-in Postgres 16-alpine service.
# Used by docker-compose.yml to build DATABASE_URL automatically.
POSTGRES_USER=hrcrm
POSTGRES_PASSWORD=replace-me-with-a-long-random-postgres-password
POSTGRES_DB=hrcrm

# Override DATABASE_URL if you want an EXTERNAL database (e.g. Render Postgres, Supabase).
# If empty / commented out, the compose file builds it from POSTGRES_* above.
# DATABASE_URL=postgresql+psycopg2://user:pass@external-host:5432/hrcrm

# Legacy / local-dev fallback: SQLite persisted in a named docker volume (no extra services).
# DATABASE_URL=sqlite+pysqlite:////data/hr_crm.db
